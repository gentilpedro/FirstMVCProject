@model IEnumerable<FirstMVCProject.Models.Lanche>

@{
    ViewData["Title"] = "LancheList";
}

<div>
    <h2>@ViewData["Titulo"]</h2>
    <h2>@ViewData["Date"]</h2>
</div>

@foreach (var lanche in Model)
{
    <div>
        <h4>@lanche.Nome</h4>
        <p><img src="@lanche.ImagemUrl" /></p>
        <h3>Preço : @lanche.Preco.ToString("c")</h3>
    </div>
}